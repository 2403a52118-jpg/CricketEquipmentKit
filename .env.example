# Database Configuration (Optional)
# By default, CricketKit works out-of-the-box using local SQLite (cricket_kit.db).
# If you wish to connect to your PostgreSQL instance, set these variables:

# Option 1: Full Connection URL
# DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/cricket_db

# Option 2: Individual Parameters
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=yourpassword
# PGDATABASE=cricket_db
